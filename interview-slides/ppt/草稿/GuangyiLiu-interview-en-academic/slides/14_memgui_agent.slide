<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        padding: 0,
    }}>
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 80,
            background: '#0E3F8C',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 40px',
            gap: 14,
        }}>
            <Box style={{
                width: 6,
                height: 28,
                background: '#FFFFFF',
            }} />
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 1 }}>
                MemGUI-Agent · Long-Horizon Agent
            </Text>
            <Box style={{
                background: '#FFC107',
                borderRadius: 4,
                padding: '3px 8px',
                marginTop: 4,
            }}>
                <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600 }}>Preprint 2026</Text>
            </Box>
        </Box>

        <Box style={{
            position: 'absolute',
            top: 80,
            left: 0,
            right: 0,
            height: 544,
            padding: '20px 40px',
            flexDirection: 'column',
            gap: 12,
        }}>
            <Box style={{
                flex: 1.25,
                flexDirection: 'row',
                gap: 18,
            }}>
                <Box style={{
                    flex: 1,
                    flexDirection: 'column',
                    gap: 10,
                }}>
                    <Box style={{
                        background: '#F7F9FC',
                        borderRadius: 6,
                        padding: '12px 14px',
                        border: '1px solid #D6DCE5',
                        borderLeft: '3px solid #D9534F',
                    }}>
                        <Text style={{ fontSize: 11, color: '#D9534F', fontWeight: 600, marginBottom: 4 }}>
                            MOTIVATION
                        </Text>
                        <Text style={{ fontSize: 12, color: '#1A2230', lineHeight: 1.55 }}>
                            ReAct-style passive history accumulation → prompt explosion + cross-app info loss: GUI-Owl-1.5-8B 71.6% on short (8.4 steps) → <span style={{ fontWeight: 'bold' }}>11.7%</span> on long (36.2 steps)
                        </Text>
                    </Box>

                    <Box style={{
                        background: '#F7F9FC',
                        borderRadius: 6,
                        padding: '12px 14px',
                        border: '1px solid #D6DCE5',
                        flex: 1,
                    }}>
                        <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600, marginBottom: 6 }}>
                            ConAct (Context-as-Action) Three Components
                        </Text>
                        <Box style={{ flexDirection: 'column', gap: 5 }}>
                            <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>History Folding ♣</span> · φ=([s,t], z): step-level distillation + span-level abstraction, issued by the policy itself
                            </Text>
                            <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>UI Memory Actions ♠</span> · extend action space A∪{'{memory_add/update/delete}'}, store <span style={{ fontWeight: 'bold' }}>full content</span> not references
                            </Text>
                            <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>Self-Describing Step ♦</span> · &lt;ui_observation&gt; (precise visible text) + &lt;action_intent&gt;, grounding material for folding & memory
                            </Text>
                        </Box>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1.1,
                    flexDirection: 'column',
                    gap: 8,
                }}>
                    <Box style={{
                        flex: 1,
                        background: '#F7F9FC',
                        borderRadius: 8,
                        border: '1px solid #D6DCE5',
                        overflow: 'hidden',
                        padding: 10,
                        alignItems: 'center',
                        justifyContent: 'center',
                    }}>
                        <Image
                            src="assets/memgui-agent-teaser.png"
                            style={{
                                width: '100%',
                                height: '100%',
                                objectFit: 'contain',
                            }}
                        />
                    </Box>
                    <Box style={{
                        background: '#E8EFF8',
                        borderRadius: 6,
                        padding: '8px 12px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 11, color: '#0E3F8C', lineHeight: 1.5, textAlign: 'center' }}>
                            5-segment output: thinking + folding + tool_call + ui_observation + action_intent
                        </Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{
                flex: 1,
                flexDirection: 'row',
                gap: 10,
            }}>
                <Box style={{
                    flex: 1,
                    background: '#E8EFF8',
                    borderRadius: 6,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600, marginBottom: 6 }}>
                        Main Results (zero-shot 235B)
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · MemGUI-Bench <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>37.5% / 62.5%</span> (P@1 / P@3), beats M3A+Gemini-2.5-Pro
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · vs same base: +13.3 P@1 · +16.8 IRR
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · MobileWorld <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>29.1%</span> SR (+14.6 vs same base)
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 6,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600, marginBottom: 6 }}>
                        Ablations (MemGUI-Bench-40)
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · Memory only: 5.0→17.5% (3.5×); Folding only: 22.5%/32.5% (P@3 low — compression loses facts)
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · Full ConAct <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>40.0%/62.5%</span>, far beyond any single component (complementary)
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · Errors -41%: process hallucination -42% · output hallucination -57%
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: '#0E3F8C',
                    borderRadius: 6,
                    padding: '12px 14px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#B8CCE4', fontWeight: 600, marginBottom: 6 }}>
                        KEY CONTRIBUTIONS
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            ConAct elevates context mgmt to policy-level behavior
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            Single forward pass jointly decides action+fold+memorize
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            MemGUI-3K (2,956 trajectories) → strongest open-data 8B
                        </Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 引用脚注 */}
        <Box style={{
            position: 'absolute',
            top: 624,
            left: 0,
            right: 0,
            height: 36,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'center',
            borderTop: '1px solid #E5E7EB',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 11, color: '#4A5568', fontStyle: 'italic', fontFamily: "'Times New Roman', Georgia, serif", textAlign: 'center', lineHeight: 1.4 }}>
                G. Liu, et al. MemGUI-Agent: An End-to-End Long-Horizon Mobile GUI Agent with Proactive Context Management. arXiv preprint, 2026.
            </Text>
        </Box>

        <Box style={{
            position: 'absolute',
            bottom: 0,
            left: 0,
            right: 0,
            height: 60,
            background: '#F7F9FC',
            borderTop: '1px solid #D6DCE5',
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>
                Zhejiang University · Control Science & Engineering
            </Text>
            <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 600 }}>
                14 / 16
            </Text>
        </Box>
    </Box>
</Slide>
