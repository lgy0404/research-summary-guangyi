<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        padding: 0,
    }}>
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 80,
            background: '#0E3F8C',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 40px',
            gap: 14,
        }}>
            <Box style={{
                width: 6,
                height: 28,
                background: '#FFFFFF',
            }} />
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 1 }}>
                LearnAct · Few-Shot Learning
            </Text>
            <Box style={{
                background: '#FFC107',
                borderRadius: 4,
                padding: '3px 8px',
                marginTop: 4,
            }}>
                <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600 }}>ACL 2026</Text>
            </Box>
        </Box>

        <Box style={{
            position: 'absolute',
            top: 80,
            left: 0,
            right: 0,
            height: 544,
            padding: '20px 40px',
            flexDirection: 'column',
            gap: 12,
        }}>
            <Box style={{
                flex: 1.25,
                flexDirection: 'row',
                gap: 18,
            }}>
                <Box style={{
                    flex: 1,
                    flexDirection: 'column',
                    gap: 10,
                }}>
                    <Box style={{
                        background: '#F7F9FC',
                        borderRadius: 6,
                        padding: '12px 14px',
                        border: '1px solid #D6DCE5',
                        borderLeft: '3px solid #D9534F',
                    }}>
                        <Text style={{ fontSize: 11, color: '#D9534F', fontWeight: 600, marginBottom: 4 }}>
                            MOTIVATION
                        </Text>
                        <Text style={{ fontSize: 12, color: '#1A2230', lineHeight: 1.55 }}>
                            Google Play has <span style={{ fontWeight: 'bold' }}>1.68M</span> apps — long-tail scenarios can't be covered by pre-training; agents generalize poorly on unseen UIs. Need <span style={{ fontWeight: 'bold' }}>gradient-free</span> adaptation.
                        </Text>
                    </Box>

                    <Box style={{
                        background: '#F7F9FC',
                        borderRadius: 6,
                        padding: '12px 14px',
                        border: '1px solid #D6DCE5',
                        flex: 1,
                    }}>
                        <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600, marginBottom: 6 }}>
                            Three-Agent Pipeline (Extract → Retrieve → Execute)
                        </Text>
                        <Box style={{ flexDirection: 'column', gap: 5 }}>
                            <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>DemoParser</span> · translate coordinate actions (CLICK[123,456]) into semantic descriptions with memory mechanism
                            </Text>
                            <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>KnowSeeker</span> · pre-compute embeddings with all-MiniLM-L6-v2; runtime cosine top-k retrieval
                            </Text>
                            <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>ActExecutor</span> · POMDP policy π: O×D→A; fuses instruction + screenshot + history + demos
                            </Text>
                        </Box>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1.1,
                    flexDirection: 'column',
                    gap: 8,
                }}>
                    <Box style={{
                        flex: 1,
                        background: '#F7F9FC',
                        borderRadius: 8,
                        border: '1px solid #D6DCE5',
                        overflow: 'hidden',
                        padding: 10,
                        alignItems: 'center',
                        justifyContent: 'center',
                    }}>
                        <Image
                            src="assets/learnact-teaser.png"
                            style={{
                                width: '100%',
                                height: '100%',
                                objectFit: 'contain',
                            }}
                        />
                    </Box>
                    <Box style={{
                        background: '#E8EFF8',
                        borderRadius: 6,
                        padding: '8px 12px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 11, color: '#0E3F8C', lineHeight: 1.5, textAlign: 'center' }}>
                            LearnGUI: 2,252 offline + 101 online tasks across long-tail apps
                        </Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{
                flex: 1,
                flexDirection: 'row',
                gap: 10,
            }}>
                <Box style={{
                    flex: 1,
                    background: '#E8EFF8',
                    borderRadius: 6,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600, marginBottom: 6 }}>
                        Key Results (single demo)
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · Gemini-1.5-Pro 0-shot <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>19.3%</span> → 1-shot <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>51.7%</span> → 3-shot 57.7%
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · UI-TARS-7B-SFT online SR 18.1% → <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>32.8%</span>, approaching GPT-4o 34.5%
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · 7B+LearnAct beats Claude Computer-Use (27.9%) & Aguvis-72B (26.1%)
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 6,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600, marginBottom: 6 }}>
                        Ablation Findings
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · Full 51.7% → w/o DemoParser <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>40.6%</span> (-11.1) → w/o KnowSeeker <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>41.6%</span> (-10.1)
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · Signal favors DemoParser; ToDo favors KnowSeeker
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.5 }}>
                            · Action similarity compensates UI difference: +38.4% match
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: '#0E3F8C',
                    borderRadius: 6,
                    padding: '12px 14px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#B8CCE4', fontWeight: 600, marginBottom: 6 }}>
                        KEY CONTRIBUTIONS
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            First demonstration-learning benchmark for mobile GUI agents
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            Extract-retrieve-execute three-agent paradigm
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            Gradient-free: 7B approaches GPT-4o
                        </Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 引用脚注 */}
        <Box style={{
            position: 'absolute',
            top: 624,
            left: 0,
            right: 0,
            height: 36,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'center',
            borderTop: '1px solid #E5E7EB',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 11, color: '#4A5568', fontStyle: 'italic', fontFamily: "'Times New Roman', Georgia, serif", textAlign: 'center', lineHeight: 1.4 }}>
                G. Liu, et al. LearnAct: Few-Shot Mobile GUI Agent with a Unified Demonstration Benchmark. ACL, 2026.
            </Text>
        </Box>

        <Box style={{
            position: 'absolute',
            bottom: 0,
            left: 0,
            right: 0,
            height: 60,
