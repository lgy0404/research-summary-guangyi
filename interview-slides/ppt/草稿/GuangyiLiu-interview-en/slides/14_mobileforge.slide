<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        padding: '0 70px',
        position: 'relative',
    }}>
        {/* A: Header */}
        <Box style={{
            height: 110,
            flexDirection: 'column',
            justifyContent: 'center',
            borderBottom: '2px solid #E2E8F0',
            gap: 6,
        }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <Box style={{
                    background: '#DBEAFE',
                    borderRadius: 4,
                    padding: '3px 10px',
                }}>
                    <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>PAPER 05 · RL + DEPLOY</Text>
                </Box>
                <Box style={{
                    background: '#F97316',
                    borderRadius: 4,
                    padding: '3px 10px',
                }}>
                    <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>Preprint 2026 · Latest</Text>
                </Box>
                <Box style={{
                    background: '#FFF7ED',
                    borderRadius: 4,
                    padding: '3px 10px',
                    border: '1px solid #FFEDD5',
                }}>
                    <Text style={{ fontSize: 11, color: '#F97316', fontWeight: 600 }}>76★ · Synced</Text>
                </Box>
            </Box>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3 }}>
                MobileForge: Annotation-Free Adaptation
            </Text>
        </Box>

        {/* B: Top two-col + bottom three-col */}
        <Box style={{
            height: 550,
            flexDirection: 'column',
            paddingTop: 18,
            paddingBottom: 16,
            gap: 12,
        }}>
            <Box style={{
                flex: 1.3,
                flexDirection: 'row',
                gap: 20,
            }}>
                <Box style={{
                    flex: 1,
                    flexDirection: 'column',
                    gap: 10,
                }}>
                    <Box style={{
                        background: '#FEF2F2',
                        borderRadius: 10,
                        padding: '10px 14px',
                        border: '1px solid #FECACA',
                    }}>
                        <Text style={{ fontSize: 11, color: '#991B1B', fontWeight: 600, marginBottom: 4 }}>
                            PROBLEM · Annotation bottleneck
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            Target-app adaptation depends on manual task/demo/reward annotation — <span style={{ fontWeight: 'bold' }}>costly, quickly outdated</span>; existing annotation-free methods lack a unified substrate and suffer from sparse rollout rewards.
                        </Text>
                    </Box>

                    <Box style={{
                        background: '#F8FAFC',
                        borderRadius: 10,
                        padding: '10px 14px',
                        border: '1px solid #E2E8F0',
                        flex: 1,
                    }}>
                        <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600, marginBottom: 6 }}>
                            METHOD · MobileGym + HiFPO Closed Loop
                        </Text>
                        <Box style={{ flexDirection: 'column', gap: 5 }}>
                            <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>MobileGym</span> · function-aware exploration (app anchor + screenshot-guided DFS) → Curriculum turns evidence pool Z into executable tasks x=(ι,B,c,v,p)
                            </Text>
                            <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>Hierarchical Critic</span> · returns F=(z, {'{ℓ}'}, h): task label z + per-step reasonable label ℓ + corrective hint h
                            </Text>
                            <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>HiFPO 3-stage</span> · ① Hint-guided multi-attempt rollout ② pick highest-Q attempt, keep only χ=1 steps ③ Hint-contextualized step-level GRPO (R=0.2·type + 0.8·param)
                            </Text>
                        </Box>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1.1,
                    flexDirection: 'column',
                    gap: 8,
                }}>
                    <Box style={{
                        flex: 1,
                        background: '#F8FAFC',
                        borderRadius: 12,
                        border: '1px solid #E2E8F0',
                        overflow: 'hidden',
                        padding: 10,
                        alignItems: 'center',
                        justifyContent: 'center',
                    }}>
                        <Image
                            src="assets/mobileforge-main-performance.png"
                            style={{
                                width: '100%',
                                height: '100%',
                                objectFit: 'contain',
                            }}
                        />
                    </Box>
                    <Box style={{
                        background: '#FFF7ED',
                        borderRadius: 8,
                        padding: '8px 12px',
                        border: '1px solid #FFEDD5',
                    }}>
                        <Text style={{ fontSize: 11, color: '#9A3412', lineHeight: 1.5, textAlign: 'center' }}>
                            Explore → generate tasks → self-evaluate rollout → hint-conditioned GRPO closed loop
                        </Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{
                flex: 1,
                flexDirection: 'row',
                gap: 12,
            }}>
                <Box style={{
                    flex: 1,
                    background: '#FFF7ED',
                    borderRadius: 10,
                    padding: '12px 14px',
                    border: '1px solid #FFEDD5',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#9A3412', fontWeight: 600, marginBottom: 6 }}>
                        Main Results (900 generated tasks)
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · ForgeOwl-8B AndroidWorld <span style={{ fontWeight: 'bold', color: '#F97316' }}>67.2% P@1 / 77.6% P@3</span>
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · ForgeQwen3-8B 67.2% P@3, near GUI-Owl-1.5-8B base 69.0%
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · MobileWorld GUI-only (OOD) <span style={{ fontWeight: 'bold', color: '#F97316' }}>41.0% SR</span>, beats all open-data peers
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: '#F8FAFC',
                    borderRadius: 10,
                    padding: '12px 14px',
                    border: '1px solid #E2E8F0',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600, marginBottom: 6 }}>
                        Ablation Findings
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · Corrective hints: rollout SR 52.0%→<span style={{ fontWeight: 'bold', color: '#F97316' }}>77.0%</span>, P@3 49.0%→72.5%
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · Counter-intuitive: drop only fully-mastered tasks (keep [0, 0.9] hardest band), not failed ones
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · Fully open-source Qwen critic (no Gemini) still lifts 40.5%→<span style={{ fontWeight: 'bold', color: '#F97316' }}>44.8%</span> P@1
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: 'linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)',
                    borderRadius: 10,
                    padding: '12px 14px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#BFDBFE', fontWeight: 600, marginBottom: 6 }}>
                        KEY CONTRIBUTIONS · IMPACT
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            First fully annotation-free target-app adaptation loop
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            HiFPO uses hierarchical feedback for task filter / step select / training conditioning
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            Deployed in Kuaishou app defect detection
                        </Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* C: Footer */}
        <Box style={{
            height: 60,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            borderTop: '1px solid #E2E8F0',
        }}>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                Guangyi Liu · ZJU · Interview
            </Text>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                14 / 15
            </Text>
        </Box>
    </Box>
</Slide>
