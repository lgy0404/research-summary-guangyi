<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: 'linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 100%)',
        position: 'relative',
        padding: 0,
    }}>
        {/* Right color band */}
        <Box style={{
            position: 'absolute',
            top: 0,
            right: 0,
            width: '38%',
            height: '100%',
            background: 'linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)',
        }} />
        <Box style={{
            position: 'absolute',
            top: 80,
            right: 60,
            width: 60,
            height: 4,
            background: '#F97316',
        }} />

        {/* Left main content */}
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            width: '62%',
            height: '100%',
            padding: '70px 40px 50px 70px',
            display: 'flex',
            flexDirection: 'column',
            justifyContent: 'space-between',
        }}>
            {/* Top label */}
            <Box style={{
                flexDirection: 'row',
                alignItems: 'center',
                gap: 12,
            }}>
                <Box style={{
                    width: 6,
                    height: 24,
                    background: '#F97316',
                }} />
                <Text style={{
                    fontSize: 15,
                    color: '#1E40AF',
                    fontWeight: 600,
                    letterSpacing: 2,
                }}>
                    TALENT PROGRAM · INTERNSHIP INTERVIEW
                </Text>
            </Box>

            {/* Middle: Name & identity */}
            <Box style={{ flexDirection: 'column', gap: 16 }}>
                <Text style={{
                    fontSize: 80,
                    fontWeight: 'bold',
                    color: '#0F172A',
                    lineHeight: 1.05,
                    letterSpacing: 1,
                }}>
                    Guangyi Liu
                </Text>
                <Text style={{
                    fontSize: 26,
                    color: '#3B82F6',
                    fontWeight: 600,
                    letterSpacing: 6,
                }}>
                    刘广义
                </Text>
                <Box style={{
                    width: 80,
                    height: 4,
                    background: '#1E40AF',
                    marginTop: 8,
                    marginBottom: 8,
                }} />
                <Text style={{
                    fontSize: 19,
                    color: '#0F172A',
                    fontWeight: 600,
                    lineHeight: 1.5,
                }}>
                    Ph.D. Candidate · Zhejiang University
                </Text>
                <Text style={{
                    fontSize: 15,
                    color: '#64748B',
                    lineHeight: 1.6,
                }}>
                    ZJU APRIL Lab · Universal Digital Agents
                </Text>
            </Box>

            {/* Bottom: Three key stat badges */}
            <Box style={{
                flexDirection: 'row',
                gap: 16,
            }}>
                <Box style={{
                    flex: 1,
                    background: '#FFFFFF',
                    borderRadius: 12,
                    padding: '16px 12px',
                    alignItems: 'center',
                    border: '1px solid #E2E8F0',
                    boxShadow: '0 4px 16px rgba(30,64,175,0.08)',
                }}>
                    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#F97316', lineHeight: 1 }}>
                        415
                    </Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>
                        Citations
                    </Text>
                </Box>
                <Box style={{
                    flex: 1,
                    background: '#FFFFFF',
                    borderRadius: 12,
                    padding: '16px 12px',
                    alignItems: 'center',
                    border: '1px solid #E2E8F0',
                    boxShadow: '0 4px 16px rgba(30,64,175,0.08)',
                }}>
                    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#F97316', lineHeight: 1 }}>
                        122
                    </Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>
                        First-Author Cit.
                    </Text>
                </Box>
                <Box style={{
                    flex: 1,
                    background: '#FFFFFF',
                    borderRadius: 12,
                    padding: '16px 12px',
                    alignItems: 'center',
                    border: '1px solid #E2E8F0',
                    boxShadow: '0 4px 16px rgba(30,64,175,0.08)',
                }}>
                    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#F97316', lineHeight: 1 }}>
                        632
                    </Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>
                        1st-Author Stars
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* Right: photo */}
        <Box style={{
            position: 'absolute',
            top: 90,
            right: 70,
            width: 340,
            height: 440,
            borderRadius: 16,
            overflow: 'hidden',
            boxShadow: '0 20px 50px rgba(0,0,0,0.25)',
            border: '6px solid #FFFFFF',
        }}>
            <Image
                src="assets/profile.jpeg"
                style={{
                    width: '100%',
                    height: '100%',
                    objectFit: 'cover',
                }}
            />
        </Box>

        {/* Contact card under photo */}
        <Box style={{
            position: 'absolute',
            bottom: 60,
            right: 70,
            width: 340,
            background: 'rgba(255,255,255,0.12)',
            borderRadius: 12,
            padding: '14px 18px',
            border: '1px solid rgba(255,255,255,0.25)',
        }}>
            <Text style={{ fontSize: 13, color: '#FFFFFF', lineHeight: 1.7, fontWeight: 500 }}>
                guangyiliu@zju.edu.cn
            </Text>
            <Text style={{ fontSize: 13, color: '#FFFFFF', lineHeight: 1.7 }}>
                +86 19550110404 · Hangzhou
            </Text>
            <Text style={{ fontSize: 13, color: '#BFDBFE', lineHeight: 1.7 }}>
                lgy0404.github.io · github.com/lgy0404
            </Text>
        </Box>

        {/* Footer date */}
        <Box style={{
            position: 'absolute',
            bottom: 20,
            left: 70,
        }}>
            <Text style={{ fontSize: 13, color: '#94A3B8' }}>
                Aug 2026 · Hangzhou
            </Text>
        </Box>
    </Box>
</Slide>
