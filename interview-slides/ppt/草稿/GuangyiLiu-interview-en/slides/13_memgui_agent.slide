<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        padding: '0 70px',
        position: 'relative',
    }}>
        {/* A: Header */}
        <Box style={{
            height: 110,
            flexDirection: 'column',
            justifyContent: 'center',
            borderBottom: '2px solid #E2E8F0',
            gap: 6,
        }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <Box style={{
                    background: '#DBEAFE',
                    borderRadius: 4,
                    padding: '3px 10px',
                }}>
                    <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>PAPER 04 · AGENT</Text>
                </Box>
                <Box style={{
                    background: '#1E40AF',
                    borderRadius: 4,
                    padding: '3px 10px',
                }}>
                    <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>Preprint 2026</Text>
                </Box>
                <Box style={{
                    background: '#FFF7ED',
                    borderRadius: 4,
                    padding: '3px 10px',
                    border: '1px solid #FFEDD5',
                }}>
                    <Text style={{ fontSize: 11, color: '#F97316', fontWeight: 600 }}>88★ · QbitAI</Text>
                </Box>
            </Box>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3 }}>
                MemGUI-Agent: End-to-End Long-Horizon GUI Agent
            </Text>
        </Box>

        {/* B: Top two-col + bottom three-col */}
        <Box style={{
            height: 550,
            flexDirection: 'column',
            paddingTop: 18,
            paddingBottom: 16,
            gap: 12,
        }}>
            <Box style={{
                flex: 1.3,
                flexDirection: 'row',
                gap: 20,
            }}>
                <Box style={{
                    flex: 1,
                    flexDirection: 'column',
                    gap: 10,
                }}>
                    <Box style={{
                        background: '#FEF2F2',
                        borderRadius: 10,
                        padding: '10px 14px',
                        border: '1px solid #FECACA',
                    }}>
                        <Text style={{ fontSize: 11, color: '#991B1B', fontWeight: 600, marginBottom: 4 }}>
                            PROBLEM · ReAct's context explosion
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            ReAct-style passive history accumulation → prompt explosion + cross-app info loss: GUI-Owl-1.5-8B 71.6% on short (8.4 steps) → <span style={{ fontWeight: 'bold' }}>11.7%</span> on long (36.2 steps)
                        </Text>
                    </Box>

                    <Box style={{
                        background: '#F8FAFC',
                        borderRadius: 10,
                        padding: '10px 14px',
                        border: '1px solid #E2E8F0',
                        flex: 1,
                    }}>
                        <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600, marginBottom: 6 }}>
                            METHOD · ConAct (Context-as-Action) Three Components
                        </Text>
                        <Box style={{ flexDirection: 'column', gap: 5 }}>
                            <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>History Folding ♣</span> · φ=([s,t], z): step-level distillation (compress single step) + span-level abstraction (fold sub-tasks into reusable records), issued by the policy itself
                            </Text>
                            <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>UI Memory Actions ♠</span> · extend action space A∪{'{memory_add/update/delete}'}, store <span style={{ fontWeight: 'bold' }}>full content</span> not references for precise cross-app retrieval
                            </Text>
                            <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                                <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>Self-Describing Step ♦</span> · &lt;ui_observation&gt; (precise visible text) + &lt;action_intent&gt;, grounding material for folding & memory
                            </Text>
                        </Box>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1.1,
                    flexDirection: 'column',
                    gap: 8,
                }}>
                    <Box style={{
                        flex: 1,
                        background: '#F8FAFC',
                        borderRadius: 12,
                        border: '1px solid #E2E8F0',
                        overflow: 'hidden',
                        padding: 10,
                        alignItems: 'center',
                        justifyContent: 'center',
                    }}>
                        <Image
                            src="assets/memgui-agent-teaser.png"
                            style={{
                                width: '100%',
                                height: '100%',
                                objectFit: 'contain',
                            }}
                        />
                    </Box>
                    <Box style={{
                        background: '#FFF7ED',
                        borderRadius: 8,
                        padding: '8px 12px',
                        border: '1px solid #FFEDD5',
                    }}>
                        <Text style={{ fontSize: 11, color: '#9A3412', lineHeight: 1.5, textAlign: 'center' }}>
                            5-segment output: thinking + folding + tool_call + ui_observation + action_intent
                        </Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{
                flex: 1,
                flexDirection: 'row',
                gap: 12,
            }}>
                <Box style={{
                    flex: 1,
                    background: '#FFF7ED',
                    borderRadius: 10,
                    padding: '12px 14px',
                    border: '1px solid #FFEDD5',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#9A3412', fontWeight: 600, marginBottom: 6 }}>
                        Main Results (zero-shot 235B)
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · MemGUI-Bench <span style={{ fontWeight: 'bold', color: '#F97316' }}>37.5% / 62.5%</span> (P@1 / P@3), beats M3A+Gemini-2.5-Pro 32.8%/47.7%
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · vs same base: +13.3 P@1 · +16.8 IRR
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · MobileWorld <span style={{ fontWeight: 'bold', color: '#F97316' }}>29.1%</span> SR (+14.6 vs same base)
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: '#F8FAFC',
                    borderRadius: 10,
                    padding: '12px 14px',
                    border: '1px solid #E2E8F0',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600, marginBottom: 6 }}>
                        Ablations (MemGUI-Bench-40)
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · Memory only: 5.0→17.5% (3.5×); Folding only: 22.5%/32.5% (P@3 low — compression loses facts); Self-desc only: 25.0%
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · Full ConAct <span style={{ fontWeight: 'bold', color: '#F97316' }}>40.0%/62.5%</span>, far beyond any single component (complementary)
                        </Text>
                        <Text style={{ fontSize: 11, color: '#0F172A', lineHeight: 1.5 }}>
                            · Errors -41%: process hallucination -42% · output hallucination -57%
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    flex: 1,
                    background: 'linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)',
                    borderRadius: 10,
                    padding: '12px 14px',
                    flexDirection: 'column',
                }}>
                    <Text style={{ fontSize: 11, color: '#BFDBFE', fontWeight: 600, marginBottom: 6 }}>
                        KEY CONTRIBUTIONS
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            ConAct elevates context mgmt to policy-level behavior
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            Single forward pass jointly decides action+fold+memorize
                        </Text>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', lineHeight: 1.5 }}>
                            MemGUI-3K (2,956 trajectories) → strongest open-data 8B
                        </Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* C: Footer */}
        <Box style={{
            height: 60,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            borderTop: '1px solid #E2E8F0',
        }}>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                Guangyi Liu · ZJU · Interview
            </Text>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                13 / 15
            </Text>
        </Box>
    </Box>
</Slide>
