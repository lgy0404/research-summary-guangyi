<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        padding: '0 70px',
        position: 'relative',
    }}>
        {/* A: Header */}
        <Box style={{
            height: 120,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderBottom: '2px solid #E2E8F0',
        }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{
                    width: 6,
                    height: 32,
                    background: '#F97316',
                }} />
                <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F172A' }}>
                    Education
                </Text>
                <Text style={{ fontSize: 16, color: '#64748B', letterSpacing: 3, marginTop: 8 }}>
                    教育背景
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                2019 - 2028 · B.Eng. → M.S. → Ph.D.
            </Text>
        </Box>

        {/* B: Timeline */}
        <Box style={{
            height: 540,
            flexDirection: 'row',
            paddingTop: 36,
            paddingBottom: 28,
            gap: 40,
        }}>
            {/* Left: timeline axis */}
            <Box style={{
                width: 200,
                flexDirection: 'column',
                alignItems: 'center',
                justifyContent: 'space-around',
                position: 'relative',
                flexShrink: 0,
            }}>
                <Box style={{
                    position: 'absolute',
                    left: '50%',
                    top: 20,
                    bottom: 20,
                    width: 3,
                    background: 'linear-gradient(180deg, #1E40AF 0%, #3B82F6 50%, #93C5FD 100%)',
                    marginLeft: -1.5,
                }} />

                <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 6, zIndex: 1 }}>
                    <Box style={{
                        width: 56,
                        height: 56,
                        borderRadius: '50%',
                        background: '#FFFFFF',
                        border: '3px solid #1E40AF',
                        alignItems: 'center',
                        justifyContent: 'center',
                        boxShadow: '0 4px 12px rgba(30,64,175,0.2)',
                    }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E40AF' }}>Ph.D.</Text>
                    </Box>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E40AF' }}>2025 - 2028</Text>
                </Box>

                <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 6, zIndex: 1 }}>
                    <Box style={{
                        width: 56,
                        height: 56,
                        borderRadius: '50%',
                        background: '#FFFFFF',
                        border: '3px solid #3B82F6',
                        alignItems: 'center',
                        justifyContent: 'center',
                        boxShadow: '0 4px 12px rgba(59,130,246,0.2)',
                    }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#3B82F6' }}>M.S.</Text>
                    </Box>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#3B82F6' }}>2023 - 2025</Text>
                </Box>

                <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 6, zIndex: 1 }}>
                    <Box style={{
                        width: 56,
                        height: 56,
                        borderRadius: '50%',
                        background: '#FFFFFF',
                        border: '3px solid #93C5FD',
                        alignItems: 'center',
                        justifyContent: 'center',
                    }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#3B82F6' }}>B.Eng.</Text>
                    </Box>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#64748B' }}>2019 - 2023</Text>
                </Box>
            </Box>

            {/* Right: Three stage cards */}
            <Box style={{
                flex: 1,
                flexDirection: 'column',
                justifyContent: 'space-between',
                gap: 18,
            }}>
                {/* Ph.D. */}
                <Box style={{
                    flex: 1,
                    background: 'linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)',
                    borderRadius: 14,
                    padding: '18px 26px',
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 22,
                    boxShadow: '0 8px 24px rgba(30,64,175,0.25)',
                }}>
                    <Box style={{
                        width: 68,
                        height: 68,
                        background: '#FFFFFF',
                        borderRadius: 12,
                        alignItems: 'center',
                        justifyContent: 'center',
                        padding: 8,
                        flexShrink: 0,
                    }}>
                        <Image src="assets/zju-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#FFFFFF' }}>
                                Zhejiang University · Ph.D.
                            </Text>
                            <Box style={{
                                background: '#F97316',
                                borderRadius: 4,
                                padding: '2px 8px',
                            }}>
                                <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>Current</Text>
                            </Box>
                        </Box>
                        <Text style={{ fontSize: 13, color: '#DBEAFE' }}>
                            Control Science & Engineering · ZJU APRIL Lab
                        </Text>
                        <Text style={{ fontSize: 12, color: '#BFDBFE', lineHeight: 1.5 }}>
                            Advisors: Prof. Yong Liu · Prof. Jiangning Zhang · Dr. Liang Liu
                        </Text>
                    </Box>
                </Box>

                {/* M.S. */}
                <Box style={{
                    flex: 1,
                    background: '#F8FAFC',
                    borderRadius: 14,
                    padding: '18px 26px',
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 22,
                    border: '1px solid #E2E8F0',
                }}>
                    <Box style={{
                        width: 68,
                        height: 68,
                        background: '#FFFFFF',
                        borderRadius: 12,
                        alignItems: 'center',
                        justifyContent: 'center',
                        padding: 8,
                        border: '1px solid #E2E8F0',
                        flexShrink: 0,
                    }}>
                        <Image src="assets/zju-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F172A' }}>
                            Zhejiang University · M.S.
                        </Text>
                        <Text style={{ fontSize: 13, color: '#64748B' }}>
                            ZJU NeSC Group · Networked Systems & Security
                        </Text>
                        <Text style={{ fontSize: 12, color: '#94A3B8', lineHeight: 1.5 }}>
                            Advisor: Prof. Wenchao Meng
                        </Text>
                    </Box>
                </Box>

                {/* B.Eng. */}
                <Box style={{
                    flex: 1,
                    background: '#F8FAFC',
                    borderRadius: 14,
                    padding: '18px 26px',
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 22,
                    border: '1px solid #E2E8F0',
                }}>
                    <Box style={{
                        width: 68,
                        height: 68,
                        background: '#FFFFFF',
                        borderRadius: 12,
                        alignItems: 'center',
                        justifyContent: 'center',
                        padding: 8,
                        border: '1px solid #E2E8F0',
                        flexShrink: 0,
                    }}>
                        <Image src="assets/cumt-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0F172A' }}>
                                CUMT · B.Eng.
                            </Text>
                            <Box style={{
                                background: '#FFF7ED',
                                borderRadius: 4,
                                padding: '2px 8px',
                                border: '1px solid #FFEDD5',
                            }}>
                                <Text style={{ fontSize: 11, color: '#F97316', fontWeight: 600 }}>No.1 / 203</Text>
                            </Box>
                        </Box>
                        <Text style={{ fontSize: 13, color: '#64748B' }}>
                            Automatic Control · China University of Mining and Technology
                        </Text>
                        <Text style={{ fontSize: 12, color: '#94A3B8', lineHeight: 1.5 }}>
                            Advisor: Prof. Wei Dai · National Scholarship (2020 & 2021)
                        </Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* C: Footer */}
        <Box style={{
            height: 60,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            borderTop: '1px solid #E2E8F0',
        }}>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                Guangyi Liu · ZJU · Interview
            </Text>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                04 / 15
            </Text>
        </Box>
    </Box>
</Slide>
