<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        padding: 0,
    }}>
        {/* A 区：页眉 */}
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 80,
            background: '#0E3F8C',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 40px',
            gap: 14,
        }}>
            <Box style={{
                width: 6,
                height: 28,
                background: '#FFFFFF',
            }} />
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 2 }}>
                个人简介
            </Text>
            <Text style={{ fontSize: 13, color: '#B8CCE4', letterSpacing: 2, marginTop: 6 }}>
                ABOUT ME
            </Text>
        </Box>

        {/* C 区：左照片右内容 */}
        <Box style={{
            position: 'absolute',
            top: 80,
            left: 0,
            right: 0,
            height: 580,
            padding: '28px 40px',
            flexDirection: 'row',
            gap: 28,
        }}>
            {/* 左：照片 + 基本信息 */}
            <Box style={{
                width: 300,
                flexDirection: 'column',
                gap: 14,
                flexShrink: 0,
            }}>
                <Box style={{
                    width: 300,
                    height: 340,
                    borderRadius: 8,
                    overflow: 'hidden',
                    border: '1px solid #D6DCE5',
                }}>
                    <Image
                        src="assets/profile.jpeg"
                        style={{
                            width: '100%',
                            height: '100%',
                            objectFit: 'cover',
                        }}
                    />
                </Box>
                {/* 信息卡 */}
                <Box style={{
                    background: '#F0F5FC',
                    borderRadius: 8,
                    padding: '16px 18px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                    gap: 6,
                }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>
                        刘广义 · Guangyi Liu
                    </Text>
                    <Text style={{ fontSize: 13, color: '#4A5568', lineHeight: 1.5 }}>
                        浙江大学 控制科学与工程学院<br />博士研究生（2025 级）
                    </Text>
                    <Box style={{ borderTop: '1px solid #D6DCE5', paddingTop: 8, marginTop: 4 }}>
                        <Text style={{ fontSize: 12, color: '#8B97A8', lineHeight: 1.6 }}>
                            guangyiliu@zju.edu.cn<br />lgy0404.github.io
                        </Text>
                    </Box>
                </Box>
            </Box>

            {/* 右：研究愿景 + 关键事实 */}
            <Box style={{
                flex: 1,
                flexDirection: 'column',
                gap: 14,
            }}>
                {/* 研究愿景 */}
                <Box style={{
                    background: '#E8EFF8',
                    borderRadius: 8,
                    padding: '18px 22px',
                    border: '1px solid #D6DCE5',
                    borderLeft: '4px solid #1E4FA8',
                }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 8 }}>
                        研究愿景
                    </Text>
                    <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.7 }}>
                        探索 <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>通用数字智能体（Universal Digital Agents）</span> 的基础能力——能理解数字环境、适应新任务、跨应用 / 跨设备 / 跨软件工作流协助人类的智能系统。
                    </Text>
                </Box>

                {/* 关键事实 2x2 */}
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Box style={{
                        flex: 1,
                        background: '#F7F9FC',
                        borderRadius: 8,
                        padding: '14px 16px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 12, color: '#8B97A8', marginBottom: 4 }}>所属实验室</Text>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>ZJU APRIL Lab</Text>
                        <Text style={{ fontSize: 12, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>
                            导师：刘勇 · 张靖宁 · 刘亮
                        </Text>
                    </Box>
                    <Box style={{
                        flex: 1,
                        background: '#F7F9FC',
                        borderRadius: 8,
                        padding: '14px 16px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 12, color: '#8B97A8', marginBottom: 4 }}>研究方向</Text>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>移动 GUI 智能体</Text>
                        <Text style={{ fontSize: 12, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>
                            Benchmark · Agent · RL · Memory
                        </Text>
                    </Box>
                </Box>

                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Box style={{
                        flex: 1,
                        background: '#F7F9FC',
                        borderRadius: 8,
                        padding: '14px 16px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 12, color: '#8B97A8', marginBottom: 4 }}>学术训练</Text>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>CUMT 第一 → ZJU 硕博</Text>
                        <Text style={{ fontSize: 12, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>
                            本科 No.1/203 · 国家奖学金
                        </Text>
                    </Box>
                    <Box style={{
                        flex: 1,
                        background: '#F7F9FC',
                        borderRadius: 8,
                        padding: '14px 16px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 12, color: '#8B97A8', marginBottom: 4 }}>工业界经历</Text>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1A2230' }}>vivo AI Lab · 快手</Text>
                        <Text style={{ fontSize: 12, color: '#4A5568', marginTop: 4, lineHeight: 1.5 }}>
                            两段研究实习 · 业务落地
                        </Text>
                    </Box>
                </Box>

                {/* 数据徽章行 */}
                <Box style={{
                    background: '#F0F5FC',
                    borderRadius: 8,
                    padding: '14px 18px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'row',
                    justifyContent: 'space-around',
                }}>
                    <Box style={{ alignItems: 'center' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>5</Text>
                        <Text style={{ fontSize: 11, color: '#4A5568', marginTop: 4 }}>一作论文</Text>
                    </Box>
                    <Box style={{ width: 1, background: '#D6DCE5' }} />
                    <Box style={{ alignItems: 'center' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>7</Text>
                        <Text style={{ fontSize: 11, color: '#4A5568', marginTop: 4 }}>合作论文</Text>
                    </Box>
                    <Box style={{ width: 1, background: '#D6DCE5' }} />
                    <Box style={{ alignItems: 'center' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>415</Text>
                        <Text style={{ fontSize: 11, color: '#4A5568', marginTop: 4 }}>总引用</Text>
                    </Box>
                    <Box style={{ width: 1, background: '#D6DCE5' }} />
                    <Box style={{ alignItems: 'center' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>632</Text>
                        <Text style={{ fontSize: 11, color: '#4A5568', marginTop: 4 }}>一作 Stars</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* D 区：页脚 */}
        <Box style={{
            position: 'absolute',
            bottom: 0,
            left: 0,
            right: 0,
            height: 60,
            background: '#F7F9FC',
            borderTop: '1px solid #D6DCE5',
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>
                浙江大学 · 控制科学与工程学院
            </Text>
            <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 600 }}>
                4 / 16
            </Text>
        </Box>
    </Box>
</Slide>
