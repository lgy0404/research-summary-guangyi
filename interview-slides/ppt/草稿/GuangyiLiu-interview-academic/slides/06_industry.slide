<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        padding: 0,
    }}>
        {/* A 区：页眉 */}
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 80,
            background: '#0E3F8C',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 40px',
            gap: 14,
        }}>
            <Box style={{
                width: 6,
                height: 28,
                background: '#FFFFFF',
            }} />
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 2 }}>
                实习经历
            </Text>
            <Text style={{ fontSize: 13, color: '#B8CCE4', letterSpacing: 2, marginTop: 6 }}>
                INDUSTRY EXPERIENCE
            </Text>
        </Box>

        {/* C 区：双栏对比 */}
        <Box style={{
            position: 'absolute',
            top: 80,
            left: 0,
            right: 0,
            height: 580,
            padding: '28px 40px',
            flexDirection: 'row',
            gap: 20,
        }}>
            {/* 左：快手 */}
            <Box style={{
                flex: 1,
                background: '#F7F9FC',
                border: '1px solid #D6DCE5',
                borderRadius: 8,
                padding: '20px 22px',
                flexDirection: 'column',
                borderLeft: '4px solid #0E3F8C',
            }}>
                {/* 头部 */}
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 14 }}>
                    <Box style={{
                        background: '#FFFFFF',
                        borderRadius: 8,
                        padding: 10,
                        width: 64,
                        height: 64,
                        alignItems: 'center',
                        justifyContent: 'center',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Image src="assets/kuaishou-icon.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                    </Box>
                    <Box style={{
                        background: '#E8EFF8',
                        borderRadius: 4,
                        padding: '4px 10px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 600 }}>
                            2025.08 - 2026.07
                        </Text>
                    </Box>
                </Box>

                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 2 }}>
                    快手科技
                </Text>
                <Text style={{ fontSize: 13, color: '#8B97A8', marginBottom: 14 }}>
                    Kuaishou Technology · 研究实习生 · 杭州
                </Text>

                {/* 项目 */}
                <Box style={{
                    background: '#FFFFFF',
                    borderRadius: 6,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    marginBottom: 12,
                }}>
                    <Text style={{ fontSize: 11, color: '#8B97A8', fontWeight: 600, marginBottom: 4 }}>
                        项目方向
                    </Text>
                    <Text style={{ fontSize: 13, color: '#1A2230', lineHeight: 1.6 }}>
                        面向 <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>App 缺陷检测</span> 的内部 GUI 智能体系统研发
                    </Text>
                </Box>

                {/* 内容要点 */}
                <Box style={{ flexDirection: 'column', gap: 8, flex: 1 }}>
                    <Box style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                        <Box style={{ width: 5, height: 5, borderRadius: '50%', background: '#1E4FA8', marginTop: 6, flexShrink: 0 }} />
                        <Text style={{ fontSize: 12, color: '#4A5568', lineHeight: 1.6, flex: 1 }}>
                            Mentor：Martin Li（李默）· 快手 Y-tech 部门
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                        <Box style={{ width: 5, height: 5, borderRadius: '50%', background: '#1E4FA8', marginTop: 6, flexShrink: 0 }} />
                        <Text style={{ fontSize: 12, color: '#4A5568', lineHeight: 1.6, flex: 1 }}>
                            将 MobileForge / MemGUI-Agent 研究成果落地到快手真实业务
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                        <Box style={{ width: 5, height: 5, borderRadius: '50%', background: '#1E4FA8', marginTop: 6, flexShrink: 0 }} />
                        <Text style={{ fontSize: 12, color: '#4A5568', lineHeight: 1.6, flex: 1 }}>
                            覆盖亿级 DAU 的 App 质量保障场景
                        </Text>
                    </Box>
                </Box>

                {/* 底部标签 */}
                <Box style={{
                    marginTop: 'auto',
                    paddingTop: 12,
                    borderTop: '1px solid #D6DCE5',
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 8,
                }}>
                    <Box style={{ background: '#0E3F8C', borderRadius: 4, padding: '3px 8px' }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>工程落地</Text>
                    </Box>
                    <Box style={{ background: '#E8EFF8', borderRadius: 4, padding: '3px 8px', border: '1px solid #D6DCE5' }}>
                        <Text style={{ fontSize: 11, color: '#1E4FA8' }}>最新</Text>
                    </Box>
                </Box>
            </Box>

            {/* 右：vivo */}
            <Box style={{
                flex: 1,
                background: '#F7F9FC',
                border: '1px solid #D6DCE5',
                borderRadius: 8,
                padding: '20px 22px',
                flexDirection: 'column',
                borderLeft: '4px solid #3D7BD9',
            }}>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 14 }}>
                    <Box style={{
                        background: '#FFFFFF',
                        borderRadius: 8,
                        padding: 10,
                        width: 64,
                        height: 64,
                        alignItems: 'center',
                        justifyContent: 'center',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Image src="assets/vivo-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                    </Box>
                    <Box style={{
                        background: '#E8EFF8',
                        borderRadius: 4,
                        padding: '4px 10px',
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 600 }}>
                            2024.08 - 2025.08
                        </Text>
                    </Box>
                </Box>

                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 2 }}>
                    vivo AI Lab
                </Text>
                <Text style={{ fontSize: 13, color: '#8B97A8', marginBottom: 14 }}>
                    vivo AI 研究院 · 研究实习生 · 杭州
                </Text>

                <Box style={{
                    background: '#FFFFFF',
                    borderRadius: 6,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    marginBottom: 12,
                }}>
                    <Text style={{ fontSize: 11, color: '#8B97A8', fontWeight: 600, marginBottom: 4 }}>
                        项目方向
                    </Text>
                    <Text style={{ fontSize: 13, color: '#1A2230', lineHeight: 1.6 }}>
                        参与 <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>vivo PhoneGPT</span>：通用手机 GUI 智能体研发
                    </Text>
                </Box>

                <Box style={{ flexDirection: 'column', gap: 8, flex: 1 }}>
                    <Box style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                        <Box style={{ width: 5, height: 5, borderRadius: '50%', background: '#3D7BD9', marginTop: 6, flexShrink: 0 }} />
                        <Text style={{ fontSize: 12, color: '#4A5568', lineHeight: 1.6, flex: 1 }}>
                            Mentor：刘亮 博士 · 李宏升 教授（CUHK）
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                        <Box style={{ width: 5, height: 5, borderRadius: '50%', background: '#3D7BD9', marginTop: 6, flexShrink: 0 }} />
                        <Text style={{ fontSize: 12, color: '#4A5568', lineHeight: 1.6, flex: 1 }}>
                            从零接触 GUI Agent 方向，奠定研究基础
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
                        <Box style={{ width: 5, height: 5, borderRadius: '50%', background: '#3D7BD9', marginTop: 6, flexShrink: 0 }} />
                        <Text style={{ fontSize: 12, color: '#4A5568', lineHeight: 1.6, flex: 1 }}>
                            产出 LearnAct / Phone GUI Survey 等奠基性成果
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    marginTop: 'auto',
                    paddingTop: 12,
                    borderTop: '1px solid #D6DCE5',
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 8,
                }}>
                    <Box style={{ background: '#3D7BD9', borderRadius: 4, padding: '3px 8px' }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>学术起步</Text>
                    </Box>
                    <Box style={{ background: '#E8EFF8', borderRadius: 4, padding: '3px 8px', border: '1px solid #D6DCE5' }}>
                        <Text style={{ fontSize: 11, color: '#1E4FA8' }}>研究型</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* D 区：页脚 */}
        <Box style={{
            position: 'absolute',
            bottom: 0,
            left: 0,
            right: 0,
            height: 60,
            background: '#F7F9FC',
            borderTop: '1px solid #D6DCE5',
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>
                浙江大学 · 控制科学与工程学院
            </Text>
            <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 600 }}>
                6 / 16
            </Text>
        </Box>
    </Box>
</Slide>
