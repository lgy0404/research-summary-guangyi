                        </Text>
                        <Box style={{ background: '#DBEAFE', borderRadius: 3, padding: '1px 6px' }}>
                            <Text style={{ fontSize: 10, color: '#0E3F8C', fontWeight: 600 }}>TMLR 2025</Text>
