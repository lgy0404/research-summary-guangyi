                        height: 18,
                        background: '#0E3F8C',
                    }} />
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0E3F8C' }}>
                        第一作者论文（5 篇）
                    </Text>
                </Box>

                {/* 5 篇论文条目 */}
                <Box style={{
                    background: '#F7F9FC',
                    borderRadius: 6,
                    padding: '10px 14px',
                    border: '1px solid #D6DCE5',
                    borderLeft: '3px solid #0E3F8C',
                    flexDirection: 'column',
                    gap: 2,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#1A2230', flex: 1 }}>
                            MobileForge · Annotation-Free GUI Adaptation
                        </Text>
                        <Box style={{ background: '#E8EFF8', borderRadius: 3, padding: '1px 6px', border: '1px solid #D6DCE5' }}>
                            <Text style={{ fontSize: 10, color: '#1E4FA8', fontWeight: 600 }}>Preprint 2026</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.5 }}>
                        无标注移动 GUI 自适应 + 分层反馈策略优化 · <span style={{ color: '#1E4FA8', fontWeight: 600 }}>76★</span> · 机器之心
                    </Text>
                </Box>

                <Box style={{
                    background: '#F7F9FC',
                    borderRadius: 6,
                    padding: '10px 14px',
                    border: '1px solid #D6DCE5',
                    borderLeft: '3px solid #0E3F8C',
                    flexDirection: 'column',
                    gap: 2,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#1A2230', flex: 1 }}>
