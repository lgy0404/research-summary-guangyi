                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>UI-Copilot</span> · ACL 2026 Main
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>MAS-Bench</span> · ACL 2026 Main
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>A3</span> · ACL 2026 Findings
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>FedGUI</span> · ACL 2026 Findings
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>FedMABench</span> · EMNLP 2025 (Oral)
                        </Text>
                        <Text style={{ fontSize: 11, color: '#1A2230', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>MobileA3gent</span> · ICML 2025 WS (Oral)
