                    </Text>
                </Box>

                <Box style={{
                    background: '#F7F9FC',
                    borderRadius: 6,
                    padding: '10px 14px',
                    border: '1px solid #D6DCE5',
                    borderLeft: '3px solid #1E4FA8',
                    flexDirection: 'column',
                    gap: 2,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#1A2230', flex: 1 }}>
                            LearnAct · 少样本演示学习
                        </Text>
                        <Box style={{ background: '#DBEAFE', borderRadius: 3, padding: '1px 6px' }}>
                            <Text style={{ fontSize: 10, color: '#0E3F8C', fontWeight: 600 }}>ACL 2026</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.5 }}>
                        LearnGUI + DemoParser / KnowSeeker / ActExecutor · <span style={{ color: '#1E4FA8', fontWeight: 600 }}>48★ · 40 引</span> · 量子位
                    </Text>
                </Box>

                <Box style={{
                    background: '#F7F9FC',
                    borderRadius: 6,
                    padding: '10px 14px',
                    border: '1px solid #D6DCE5',
                    borderLeft: '3px solid #1E4FA8',
                    flexDirection: 'column',
                    gap: 2,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#1A2230', flex: 1 }}>
