                            <Text style={{ fontSize: 10, color: '#0E3F8C', fontWeight: 600 }}>ACM MM 2026</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.5 }}>
