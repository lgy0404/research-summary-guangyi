                            <Text style={{ fontSize: 10, color: '#4A5568', marginTop: 4 }}>总引用</Text>
                        </Box>
                        <Box style={{ width: 1, background: '#D6DCE5' }} />
                        <Box style={{ alignItems: 'center' }}>
                            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>122</Text>
                            <Text style={{ fontSize: 10, color: '#4A5568', marginTop: 4 }}>一作引用</Text>
                        </Box>
                        <Box style={{ width: 1, background: '#D6DCE5' }} />
                        <Box style={{ alignItems: 'center' }}>
                            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>632</Text>
                            <Text style={{ fontSize: 10, color: '#4A5568', marginTop: 4 }}>一作 Stars</Text>
