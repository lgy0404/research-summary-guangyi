<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        padding: 0,
    }}>
        {/* A 区：页眉 */}
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 80,
            background: '#0E3F8C',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 40px',
            gap: 14,
        }}>
            <Box style={{
                width: 6,
                height: 28,
                background: '#FFFFFF',
            }} />
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 2 }}>
                论文成果总览
            </Text>
            <Text style={{ fontSize: 13, color: '#B8CCE4', letterSpacing: 2, marginTop: 6 }}>
                PUBLICATIONS
            </Text>
        </Box>

        {/* C 区：左一作 + 右合作&指标 */}
        <Box style={{
            position: 'absolute',
            top: 80,
            left: 0,
            right: 0,
            height: 580,
            padding: '20px 40px',
            flexDirection: 'row',
            gap: 20,
        }}>
            {/* 左：一作论文 */}
            <Box style={{
                flex: 2,
                flexDirection: 'column',
                gap: 8,
            }}>
                <Box style={{
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 8,
