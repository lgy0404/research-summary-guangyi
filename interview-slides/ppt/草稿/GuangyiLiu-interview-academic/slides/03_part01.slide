<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#0E3F8C',
        position: 'relative',
        padding: 0,
    }}>
        {/* 中央内容 */}
        <Box style={{
            width: '100%',
            height: '100%',
            flexDirection: 'column',
            alignItems: 'center',
            justifyContent: 'center',
            gap: 28,
            padding: '0 100px',
        }}>
            {/* 大数字 */}
            <Text style={{
                fontSize: 180,
                fontWeight: 'bold',
                color: 'rgba(255,255,255,0.15)',
                lineHeight: 1,
                letterSpacing: 8,
            }}>
                01
            </Text>

            {/* 上标 */}
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                <Box style={{ width: 40, height: 2, background: '#FFC107' }} />
                <Text style={{
                    fontSize: 14,
                    color: '#FFC107',
                    fontWeight: 600,
                    letterSpacing: 4,
                    fontFamily: "'Times New Roman', Georgia, serif",
                }}>
                    PART 01
                </Text>
                <Box style={{ width: 40, height: 2, background: '#FFC107' }} />
            </Box>

            {/* 主标题 */}
            <Text style={{
                fontSize: 64,
                fontWeight: 'bold',
                color: '#FFFFFF',
                letterSpacing: 6,
                lineHeight: 1.2,
                textAlign: 'center',
            }}>
                个人整体情况介绍
            </Text>

            {/* 英文副标（衬线） */}
            <Text style={{
                fontSize: 14,
                color: '#9DB8D8',
                letterSpacing: 2,
                textAlign: 'center',
                fontStyle: 'italic',
                fontFamily: "'Times New Roman', Georgia, serif",
            }}>
                Personal Overview
            </Text>

            {/* 副标题 */}
            <Text style={{
                fontSize: 18,
                color: '#B8CCE4',
                letterSpacing: 2,
                textAlign: 'center',
                lineHeight: 1.6,
            }}>
                教育背景 · 实习经历 · 研究方向 · 学术成果
            </Text>

            {/* 章节清单 */}
            <Box style={{
                flexDirection: 'row',
                gap: 10,
                marginTop: 8,
                flexWrap: 'wrap',
                justifyContent: 'center',
            }}>
                <Box style={{
                    background: 'rgba(255,255,255,0.1)',
                    borderRadius: 6,
                    padding: '8px 16px',
                    border: '1px solid rgba(255,255,255,0.2)',
                }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 600 }}>
                        个人简介
                    </Text>
                </Box>
                <Box style={{
                    background: 'rgba(255,255,255,0.1)',
                    borderRadius: 6,
                    padding: '8px 16px',
                    border: '1px solid rgba(255,255,255,0.2)',
                }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 600 }}>
                        教育背景
                    </Text>
                </Box>
                <Box style={{
                    background: 'rgba(255,255,255,0.1)',
                    borderRadius: 6,
                    padding: '8px 16px',
                    border: '1px solid rgba(255,255,255,0.2)',
                }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 600 }}>
                        实习经历
                    </Text>
                </Box>
                <Box style={{
                    background: 'rgba(255,255,255,0.1)',
                    borderRadius: 6,
                    padding: '8px 16px',
                    border: '1px solid rgba(255,255,255,0.2)',
                }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 600 }}>
                        研究方向与成果
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* 页脚 */}
        <Box style={{
            position: 'absolute',
            bottom: 24,
            left: 0,
            right: 0,
            flexDirection: 'row',
            justifyContent: 'space-between',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.5)' }}>
                浙江大学 · 控制科学与工程学院
            </Text>
            <Text style={{ fontSize: 13, color: 'rgba(255,255,255,0.5)' }}>
                03 / 16
            </Text>
        </Box>
    </Box>
</Slide>
