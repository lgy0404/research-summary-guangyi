<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        padding: 0,
    }}>
        {/* A 区：页眉 */}
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 80,
            background: '#0E3F8C',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 40px',
            gap: 14,
        }}>
            <Box style={{
                width: 6,
                height: 28,
                background: '#FFFFFF',
            }} />
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 2 }}>
                研究方向
            </Text>
            <Text style={{ fontSize: 13, color: '#B8CCE4', letterSpacing: 2, marginTop: 6 }}>
                RESEARCH VISION
            </Text>
        </Box>

        {/* C 区：顶部定位条 + 四阶段 + 底部特色 */}
        <Box style={{
            position: 'absolute',
            top: 80,
            left: 0,
            right: 0,
            height: 580,
            padding: '24px 40px',
            flexDirection: 'column',
            gap: 14,
        }}>
            {/* 顶部定位 */}
            <Box style={{
                background: '#E8EFF8',
                borderRadius: 8,
                padding: '14px 20px',
                border: '1px solid #D6DCE5',
                borderLeft: '4px solid #0E3F8C',
            }}>
                <Text style={{ fontSize: 16, color: '#0E3F8C', fontWeight: 600, lineHeight: 1.6 }}>
                    让手机 / 电脑像人一样被 AI 操作 —— 从「读懂界面」到「完成任务」
                </Text>
            </Box>

            {/* 四阶段 */}
            <Box style={{
                flex: 1,
                flexDirection: 'row',
                gap: 12,
                alignItems: 'stretch',
            }}>
                {/* 阶段 1 */}
                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 8,
                    padding: '14px 16px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                }}>
                    <Box style={{
                        background: '#E8EFF8',
                        borderRadius: 4,
                        padding: '3px 8px',
                        alignSelf: 'flex-start',
                        marginBottom: 8,
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 10, color: '#1E4FA8', fontWeight: 600 }}>STEP 1 · 认知领域</Text>
                    </Box>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4, marginBottom: 6 }}>
                        Phone GUI Survey
                    </Text>
                    <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.55, marginBottom: 8 }}>
                        系统梳理 LLM 驱动手机 GUI 智能体：框架 / 模型 / 数据 / 评测
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #D6DCE5' }}>
                        <Text style={{ fontSize: 11, color: '#1E4FA8', fontWeight: 600 }}>
                            TMLR 2025 · 175★ · 64 引
                        </Text>
                    </Box>
                </Box>

                <Box style={{ alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 20, color: '#1E4FA8', fontWeight: 'bold' }}>→</Text>
                </Box>

                {/* 阶段 2 */}
                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 8,
                    padding: '14px 16px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                }}>
                    <Box style={{
                        background: '#E8EFF8',
                        borderRadius: 4,
                        padding: '3px 8px',
                        alignSelf: 'flex-start',
                        marginBottom: 8,
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 10, color: '#1E4FA8', fontWeight: 600 }}>STEP 2 · 定义任务</Text>
                    </Box>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4, marginBottom: 6 }}>
                        LearnAct · MemGUI-Bench
                    </Text>
                    <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.55, marginBottom: 8 }}>
                        少样本演示学习 + 记忆能力 Benchmark，定义「该做什么」
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #D6DCE5' }}>
                        <Text style={{ fontSize: 11, color: '#1E4FA8', fontWeight: 600 }}>
                            ACL 2026 · ACM MM 2026
                        </Text>
                    </Box>
                </Box>

                <Box style={{ alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 20, color: '#1E4FA8', fontWeight: 'bold' }}>→</Text>
                </Box>

                {/* 阶段 3 */}
                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 8,
                    padding: '14px 16px',
                    border: '1px solid #D6DCE5',
                    flexDirection: 'column',
                }}>
                    <Box style={{
                        background: '#E8EFF8',
                        borderRadius: 4,
                        padding: '3px 8px',
                        alignSelf: 'flex-start',
                        marginBottom: 8,
                        border: '1px solid #D6DCE5',
                    }}>
                        <Text style={{ fontSize: 10, color: '#1E4FA8', fontWeight: 600 }}>STEP 3 · 构建模型</Text>
                    </Box>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4, marginBottom: 6 }}>
                        MemGUI-Agent
                    </Text>
                    <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.55, marginBottom: 8 }}>
                        端到端长时程 GUI 智能体，主动上下文管理
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #D6DCE5' }}>
                        <Text style={{ fontSize: 11, color: '#1E4FA8', fontWeight: 600 }}>
                            Preprint 2026 · 88★
                        </Text>
                    </Box>
                </Box>

                <Box style={{ alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 20, color: '#0E3F8C', fontWeight: 'bold' }}>→</Text>
                </Box>

                {/* 阶段 4 */}
                <Box style={{
                    flex: 1,
                    background: '#E8EFF8',
                    borderRadius: 8,
                    padding: '14px 16px',
                    border: '2px solid #0E3F8C',
                    flexDirection: 'column',
                }}>
                    <Box style={{
                        background: '#0E3F8C',
                        borderRadius: 4,
                        padding: '3px 8px',
                        alignSelf: 'flex-start',
                        marginBottom: 8,
                    }}>
                        <Text style={{ fontSize: 10, color: '#FFFFFF', fontWeight: 600 }}>STEP 4 · 工程落地</Text>
                    </Box>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.4, marginBottom: 6 }}>
                        MobileForge
                    </Text>
                    <Text style={{ fontSize: 11, color: '#4A5568', lineHeight: 1.55, marginBottom: 8 }}>
                        无标注自适应 + 分层反馈策略优化，业务级 GUI 智能体
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #D6DCE5' }}>
                        <Text style={{ fontSize: 11, color: '#0E3F8C', fontWeight: 600 }}>
                            Preprint 2026 · 76★ · 机器之心
                        </Text>
                    </Box>
                </Box>
            </Box>

            {/* 底部特色 */}
            <Box style={{
                flexDirection: 'row',
                gap: 12,
            }}>
                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 8,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C', fontWeight: 600 }}>
                        Benchmark 驱动
                    </Text>
                    <Text style={{ fontSize: 11, color: '#8B97A8', marginTop: 2 }}>
                        用科学评测定义研究问题
                    </Text>
                </Box>
                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 8,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C', fontWeight: 600 }}>
                        学术 + 工业双轨
                    </Text>
                    <Text style={{ fontSize: 11, color: '#8B97A8', marginTop: 2 }}>
                        顶会论文 + 业务落地
                    </Text>
                </Box>
                <Box style={{
                    flex: 1,
                    background: '#F7F9FC',
                    borderRadius: 8,
                    padding: '12px 14px',
                    border: '1px solid #D6DCE5',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C', fontWeight: 600 }}>
                        开源与影响力
                    </Text>
                    <Text style={{ fontSize: 11, color: '#8B97A8', marginTop: 2 }}>
