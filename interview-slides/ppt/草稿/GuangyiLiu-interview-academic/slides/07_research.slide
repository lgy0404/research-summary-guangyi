        </Box>

        {/* D 区：页脚 */}
        <Box style={{
            position: 'absolute',
            bottom: 0,
            left: 0,
            right: 0,
            height: 60,
            background: '#F7F9FC',
            borderTop: '1px solid #D6DCE5',
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>
                浙江大学 · 控制科学与工程学院
            </Text>
            <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 600 }}>
