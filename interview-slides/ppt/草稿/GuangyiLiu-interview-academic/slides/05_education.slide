<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        position: 'relative',
        padding: 0,
    }}>
        {/* A 区：页眉 */}
        <Box style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 80,
            background: '#0E3F8C',
            flexDirection: 'row',
            alignItems: 'center',
            padding: '0 40px',
            gap: 14,
        }}>
            <Box style={{
                width: 6,
                height: 28,
                background: '#FFFFFF',
            }} />
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 2 }}>
                教育背景
            </Text>
            <Text style={{ fontSize: 13, color: '#B8CCE4', letterSpacing: 2, marginTop: 6 }}>
                EDUCATION
            </Text>
        </Box>

        {/* C 区：三段时间卡 */}
        <Box style={{
            position: 'absolute',
            top: 80,
            left: 0,
            right: 0,
            height: 580,
            padding: '28px 40px',
            flexDirection: 'column',
            gap: 14,
        }}>
            {/* 博士 */}
            <Box style={{
                flex: 1,
                background: '#E8EFF8',
                border: '1px solid #D6DCE5',
                borderRadius: 8,
                padding: '18px 24px',
                flexDirection: 'row',
                alignItems: 'center',
                gap: 22,
                borderLeft: '4px solid #0E3F8C',
            }}>
                <Box style={{
                    width: 72,
                    height: 72,
                    background: '#FFFFFF',
                    borderRadius: 8,
                    padding: 8,
                    border: '1px solid #D6DCE5',
                    alignItems: 'center',
                    justifyContent: 'center',
                    flexShrink: 0,
                }}>
                    <Image src="assets/zju-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>
                            浙江大学 · 博士研究生
                        </Text>
                        <Box style={{
                            background: '#1E4FA8',
                            borderRadius: 4,
                            padding: '2px 8px',
                        }}>
                            <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>在读 · 2025.09 - 2028.06</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#4A5568' }}>
                        控制科学与工程学院 · ZJU APRIL Lab
                    </Text>
                    <Text style={{ fontSize: 13, color: '#8B97A8', lineHeight: 1.5 }}>
                        导师：刘勇 教授 · 张靖宁 教授 · 刘亮 博士 ｜ 研究方向：通用数字智能体
                    </Text>
                </Box>
                <Box style={{
                    background: '#0E3F8C',
                    borderRadius: 6,
                    padding: '10px 16px',
                    alignItems: 'center',
                    flexShrink: 0,
                }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>Ph.D.</Text>
                </Box>
            </Box>

            {/* 硕士 */}
            <Box style={{
                flex: 1,
                background: '#F7F9FC',
                border: '1px solid #D6DCE5',
                borderRadius: 8,
                padding: '18px 24px',
                flexDirection: 'row',
                alignItems: 'center',
                gap: 22,
                borderLeft: '4px solid #1E4FA8',
            }}>
                <Box style={{
                    width: 72,
                    height: 72,
                    background: '#FFFFFF',
                    borderRadius: 8,
                    padding: 8,
                    border: '1px solid #D6DCE5',
                    alignItems: 'center',
                    justifyContent: 'center',
                    flexShrink: 0,
                }}>
                    <Image src="assets/zju-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>
                            浙江大学 · 硕士研究生
                        </Text>
                        <Box style={{
                            background: '#E8EFF8',
                            borderRadius: 4,
                            padding: '2px 8px',
                            border: '1px solid #D6DCE5',
                        }}>
                            <Text style={{ fontSize: 11, color: '#1E4FA8', fontWeight: 600 }}>2023.06 - 2025.08</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#4A5568' }}>
                        ZJU NeSC Group · 网络系统与安全
                    </Text>
                    <Text style={{ fontSize: 13, color: '#8B97A8', lineHeight: 1.5 }}>
                        导师：孟文超 教授 ｜ 硕士学位
                    </Text>
                </Box>
                <Box style={{
                    background: '#1E4FA8',
                    borderRadius: 6,
                    padding: '10px 16px',
                    alignItems: 'center',
                    flexShrink: 0,
                }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>M.S.</Text>
                </Box>
            </Box>

            {/* 本科 */}
            <Box style={{
                flex: 1,
                background: '#F7F9FC',
                border: '1px solid #D6DCE5',
                borderRadius: 8,
                padding: '18px 24px',
                flexDirection: 'row',
                alignItems: 'center',
                gap: 22,
                borderLeft: '4px solid #3D7BD9',
            }}>
                <Box style={{
                    width: 72,
                    height: 72,
                    background: '#FFFFFF',
                    borderRadius: 8,
                    padding: 8,
                    border: '1px solid #D6DCE5',
                    alignItems: 'center',
                    justifyContent: 'center',
                    flexShrink: 0,
                }}>
                    <Image src="assets/cumt-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>
                            中国矿业大学 · 本科
                        </Text>
                        <Box style={{
                            background: '#E8EFF8',
                            borderRadius: 4,
                            padding: '2px 8px',
                            border: '1px solid #D6DCE5',
                        }}>
                            <Text style={{ fontSize: 11, color: '#1E4FA8', fontWeight: 600 }}>2019.09 - 2023.06</Text>
                        </Box>
                        <Box style={{
                            background: '#0E3F8C',
                            borderRadius: 4,
                            padding: '2px 8px',
                        }}>
                            <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>No.1 / 203</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#4A5568' }}>
                        自动化专业 · 工学学士
                    </Text>
                    <Text style={{ fontSize: 13, color: '#8B97A8', lineHeight: 1.5 }}>
                        导师：代伟 教授 ｜ 国家奖学金（2020 & 2021）· 江苏省优秀毕业生
                    </Text>
                </Box>
                <Box style={{
                    background: '#3D7BD9',
                    borderRadius: 6,
                    padding: '10px 16px',
                    alignItems: 'center',
                    flexShrink: 0,
                }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>B.Eng.</Text>
                </Box>
            </Box>
        </Box>

        {/* D 区：页脚 */}
        <Box style={{
            position: 'absolute',
            bottom: 0,
            left: 0,
            right: 0,
            height: 60,
            background: '#F7F9FC',
            borderTop: '1px solid #D6DCE5',
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            padding: '0 40px',
        }}>
            <Text style={{ fontSize: 13, color: '#8B97A8' }}>
                浙江大学 · 控制科学与工程学院
            </Text>
            <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 600 }}>
                5 / 16
            </Text>
        </Box>
    </Box>
</Slide>
