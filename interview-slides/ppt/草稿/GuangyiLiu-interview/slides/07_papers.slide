<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        padding: '0 70px',
        position: 'relative',
    }}>
        {/* A 区：标题块 */}
        <Box style={{
            height: 120,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderBottom: '2px solid #E2E8F0',
        }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{
                    width: 6,
                    height: 32,
                    background: '#F97316',
                }} />
                <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F172A' }}>
                    论文成果总览
                </Text>
                <Text style={{ fontSize: 16, color: '#64748B', letterSpacing: 3, marginTop: 8 }}>
                    PUBLICATIONS
                </Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center' }}>
                <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                    5 篇一作 · 7 篇合作
                </Text>
            </Box>
        </Box>

        {/* B 区：左一作列表 + 右合作+指标 */}
        <Box style={{
            height: 540,
            flexDirection: 'row',
            gap: 24,
            paddingTop: 24,
            paddingBottom: 20,
        }}>
            {/* 左：一作论文（5 篇，占 2/3） */}
            <Box style={{
                flex: 2,
                flexDirection: 'column',
                gap: 10,
            }}>
                <Box style={{
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 10,
                    marginBottom: 4,
                }}>
                    <Box style={{
                        width: 4,
                        height: 20,
                        background: '#F97316',
                    }} />
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A' }}>
                        第一作者论文（5 篇）
                    </Text>
                </Box>

                {/* 论文条目 1 */}
                <Box style={{
                    background: '#F8FAFC',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #E2E8F0',
                    borderLeft: '4px solid #F97316',
                    flexDirection: 'column',
                    gap: 4,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A', flex: 1 }}>
                            MobileForge · Annotation-Free GUI Agent Adaptation
                        </Text>
                        <Box style={{ background: '#FFF7ED', borderRadius: 4, padding: '2px 8px', border: '1px solid #FFEDD5' }}>
                            <Text style={{ fontSize: 11, color: '#F97316', fontWeight: 600 }}>Preprint 2026</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.5 }}>
                        无标注移动 GUI 自适应 + 分层反馈策略优化（HiFPO）· <span style={{ color: '#F97316', fontWeight: 600 }}>76★</span> · 机器之心报道
                    </Text>
                </Box>

                {/* 论文条目 2 */}
                <Box style={{
                    background: '#F8FAFC',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #E2E8F0',
                    borderLeft: '4px solid #F97316',
                    flexDirection: 'column',
                    gap: 4,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A', flex: 1 }}>
                            MemGUI-Agent · 长时程主动上下文管理
                        </Text>
                        <Box style={{ background: '#FFF7ED', borderRadius: 4, padding: '2px 8px', border: '1px solid #FFEDD5' }}>
                            <Text style={{ fontSize: 11, color: '#F97316', fontWeight: 600 }}>Preprint 2026</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.5 }}>
                        端到端长时程移动 GUI 智能体（ConAct）· <span style={{ color: '#F97316', fontWeight: 600 }}>88★</span> · 量子位报道
                    </Text>
                </Box>

                {/* 论文条目 3 */}
                <Box style={{
                    background: '#F8FAFC',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #E2E8F0',
                    borderLeft: '4px solid #3B82F6',
                    flexDirection: 'column',
                    gap: 4,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A', flex: 1 }}>
                            MemGUI-Bench · 动态环境记忆 Benchmark
                        </Text>
                        <Box style={{ background: '#DBEAFE', borderRadius: 4, padding: '2px 8px' }}>
                            <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>ACM MM 2026</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.5 }}>
                        128 任务 / 26 App 跨时空记忆评测 · <span style={{ color: '#F97316', fontWeight: 600 }}>48★ · 17 引</span>
                    </Text>
                </Box>

                {/* 论文条目 4 */}
                <Box style={{
                    background: '#F8FAFC',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #E2E8F0',
                    borderLeft: '4px solid #3B82F6',
                    flexDirection: 'column',
                    gap: 4,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A', flex: 1 }}>
                            LearnAct · 少样本演示学习
                        </Text>
                        <Box style={{ background: '#DBEAFE', borderRadius: 4, padding: '2px 8px' }}>
                            <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>ACL 2026</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.5 }}>
                        LearnGUI Benchmark + DemoParser / KnowSeeker / ActExecutor · <span style={{ color: '#F97316', fontWeight: 600 }}>48★ · 40 引</span> · 量子位
                    </Text>
                </Box>

                {/* 论文条目 5 */}
                <Box style={{
                    background: '#F8FAFC',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #E2E8F0',
                    borderLeft: '4px solid #3B82F6',
                    flexDirection: 'column',
                    gap: 4,
                }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A', flex: 1 }}>
                            Phone GUI Agent Survey · 综述
                        </Text>
                        <Box style={{ background: '#DBEAFE', borderRadius: 4, padding: '2px 8px' }}>
                            <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>TMLR 2025</Text>
                        </Box>
                    </Box>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.5 }}>
                        LLM 驱动手机 GUI 智能体系统综述 · <span style={{ color: '#F97316', fontWeight: 600 }}>175★ · 64 引</span> · 机器之心
                    </Text>
                </Box>
            </Box>

            {/* 右：合作论文 + 引用指标（占 1/3） */}
            <Box style={{
                flex: 1,
                flexDirection: 'column',
                gap: 14,
            }}>
                {/* 引用数据卡 */}
                <Box style={{
                    background: 'linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)',
                    borderRadius: 12,
                    padding: '18px 20px',
                    flexDirection: 'column',
                    gap: 10,
                    boxShadow: '0 8px 24px rgba(30,64,175,0.2)',
                }}>
                    <Text style={{ fontSize: 13, color: '#BFDBFE', fontWeight: 600, letterSpacing: 1 }}>
                        学术影响力
                    </Text>
                    <Box style={{ flexDirection: 'row', justifyContent: 'space-around' }}>
                        <Box style={{ alignItems: 'center' }}>
                            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1 }}>415</Text>
                            <Text style={{ fontSize: 11, color: '#DBEAFE', marginTop: 4 }}>总引用</Text>
                        </Box>
                        <Box style={{ width: 1, background: 'rgba(255,255,255,0.3)' }} />
                        <Box style={{ alignItems: 'center' }}>
                            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FCD34D', lineHeight: 1 }}>122</Text>
                            <Text style={{ fontSize: 11, color: '#DBEAFE', marginTop: 4 }}>一作引用</Text>
                        </Box>
                        <Box style={{ width: 1, background: 'rgba(255,255,255,0.3)' }} />
                        <Box style={{ alignItems: 'center' }}>
                            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FCD34D', lineHeight: 1 }}>632</Text>
                            <Text style={{ fontSize: 11, color: '#DBEAFE', marginTop: 4 }}>一作 Stars</Text>
                        </Box>
                    </Box>
                </Box>

                {/* 合作论文列表 */}
                <Box style={{ flexDirection: 'column', gap: 8, flex: 1 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 4, height: 20, background: '#3B82F6' }} />
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F172A' }}>
                            合作论文（7 篇）
                        </Text>
                    </Box>
                    <Box style={{
                        background: '#F8FAFC',
                        borderRadius: 10,
                        padding: '14px 16px',
                        border: '1px solid #E2E8F0',
                        flex: 1,
                        flexDirection: 'column',
                        justifyContent: 'space-around',
                    }}>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>UI-R1</span> · AAAI 2026 · <span style={{ color: '#F97316' }}>212 引</span>
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>UI-Copilot</span> · ACL 2026 Main
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>MAS-Bench</span> · ACL 2026 Main
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>A3</span> · ACL 2026 Findings
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>FedGUI</span> · ACL 2026 Findings
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>FedMABench</span> · EMNLP 2025 (Oral)
                        </Text>
                        <Text style={{ fontSize: 12, color: '#0F172A', lineHeight: 1.55 }}>
                            <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>MobileA3gent</span> · ICML 2025 Workshop (Oral)
                        </Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* C 区：页脚 */}
        <Box style={{
            height: 60,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            borderTop: '1px solid #E2E8F0',
        }}>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                Guangyi Liu · ZJU · 面试陈述
            </Text>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                07 / 15
            </Text>
        </Box>
    </Box>
</Slide>
