<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        padding: '0 70px',
        position: 'relative',
    }}>
        {/* A 区：标题块 */}
        <Box style={{
            height: 120,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderBottom: '2px solid #E2E8F0',
        }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{
                    width: 6,
                    height: 32,
                    background: '#F97316',
                }} />
                <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F172A' }}>
                    研究方向
                </Text>
                <Text style={{ fontSize: 16, color: '#64748B', letterSpacing: 3, marginTop: 8 }}>
                    RESEARCH VISION
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                移动 GUI 智能体 · 通用数字智能体
            </Text>
        </Box>

        {/* B 区：研究版图 */}
        <Box style={{
            height: 540,
            paddingTop: 28,
            paddingBottom: 20,
            flexDirection: 'column',
            gap: 16,
        }}>
            {/* 顶部一句话定位 */}
            <Box style={{
                background: 'linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)',
                borderRadius: 12,
                padding: '16px 24px',
                alignItems: 'center',
            }}>
                <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 600, lineHeight: 1.5 }}>
                    让手机 / 电脑像人一样被 AI 操作 —— <span style={{ color: '#FCD34D' }}>从「读懂界面」到「完成任务」</span>
                </Text>
            </Box>

            {/* 研究版图：四阶段演进 */}
            <Box style={{
                flex: 1,
                flexDirection: 'row',
                gap: 14,
                alignItems: 'stretch',
            }}>
                {/* 阶段 1 */}
                <Box style={{
                    flex: 1,
                    background: '#F8FAFC',
                    borderRadius: 12,
                    padding: '16px 18px',
                    border: '1px solid #E2E8F0',
                    flexDirection: 'column',
                }}>
                    <Box style={{
                        background: '#DBEAFE',
                        borderRadius: 6,
                        padding: '4px 10px',
                        alignSelf: 'flex-start',
                        marginBottom: 10,
                    }}>
                        <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>STEP 1 · 认知领域</Text>
                    </Box>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.4, marginBottom: 6 }}>
                        Phone GUI Survey
                    </Text>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.6, marginBottom: 10 }}>
                        系统梳理 LLM 驱动的手机 GUI 智能体：框架 / 模型 / 数据 / 评测
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #E2E8F0' }}>
                        <Text style={{ fontSize: 12, color: '#F97316', fontWeight: 600 }}>
                            TMLR 2025 · 175★ · 64 引
                        </Text>
                    </Box>
                </Box>

                {/* 箭头 */}
                <Box style={{ alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 24, color: '#3B82F6', fontWeight: 'bold' }}>→</Text>
                </Box>

                {/* 阶段 2 */}
                <Box style={{
                    flex: 1,
                    background: '#F8FAFC',
                    borderRadius: 12,
                    padding: '16px 18px',
                    border: '1px solid #E2E8F0',
                    flexDirection: 'column',
                }}>
                    <Box style={{
                        background: '#DBEAFE',
                        borderRadius: 6,
                        padding: '4px 10px',
                        alignSelf: 'flex-start',
                        marginBottom: 10,
                    }}>
                        <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>STEP 2 · 定义任务</Text>
                    </Box>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.4, marginBottom: 6 }}>
                        LearnAct · MemGUI-Bench
                    </Text>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.6, marginBottom: 10 }}>
                        少样本演示学习 + 记忆能力 Benchmark，定义「该做什么」
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #E2E8F0' }}>
                        <Text style={{ fontSize: 12, color: '#F97316', fontWeight: 600 }}>
                            ACL 2026 · ACM MM 2026
                        </Text>
                    </Box>
                </Box>

                {/* 箭头 */}
                <Box style={{ alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 24, color: '#3B82F6', fontWeight: 'bold' }}>→</Text>
                </Box>

                {/* 阶段 3 */}
                <Box style={{
                    flex: 1,
                    background: '#F8FAFC',
                    borderRadius: 12,
                    padding: '16px 18px',
                    border: '1px solid #E2E8F0',
                    flexDirection: 'column',
                }}>
                    <Box style={{
                        background: '#DBEAFE',
                        borderRadius: 6,
                        padding: '4px 10px',
                        alignSelf: 'flex-start',
                        marginBottom: 10,
                    }}>
                        <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>STEP 3 · 构建模型</Text>
                    </Box>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.4, marginBottom: 6 }}>
                        MemGUI-Agent
                    </Text>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.6, marginBottom: 10 }}>
                        端到端长时程 GUI 智能体，主动上下文管理
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #E2E8F0' }}>
                        <Text style={{ fontSize: 12, color: '#F97316', fontWeight: 600 }}>
                            Preprint 2026 · 88★
                        </Text>
                    </Box>
                </Box>

                {/* 箭头 */}
                <Box style={{ alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 24, color: '#F97316', fontWeight: 'bold' }}>→</Text>
                </Box>

                {/* 阶段 4 - 当前重点 */}
                <Box style={{
                    flex: 1,
                    background: 'linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%)',
                    borderRadius: 12,
                    padding: '16px 18px',
                    border: '2px solid #F97316',
                    flexDirection: 'column',
                    boxShadow: '0 8px 24px rgba(249,115,22,0.15)',
                }}>
                    <Box style={{
                        background: '#F97316',
                        borderRadius: 6,
                        padding: '4px 10px',
                        alignSelf: 'flex-start',
                        marginBottom: 10,
                    }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>STEP 4 · 工程落地</Text>
                    </Box>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.4, marginBottom: 6 }}>
                        MobileForge
                    </Text>
                    <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.6, marginBottom: 10 }}>
                        无标注自适应 + 分层反馈策略优化，业务级 GUI 智能体
                    </Text>
                    <Box style={{ marginTop: 'auto', paddingTop: 8, borderTop: '1px solid #FFEDD5' }}>
                        <Text style={{ fontSize: 12, color: '#F97316', fontWeight: 600 }}>
                            Preprint 2026 · 76★ · 机器之心
                        </Text>
                    </Box>
                </Box>
            </Box>

            {/* 底部：研究特色总结 */}
            <Box style={{
                flexDirection: 'row',
                gap: 12,
            }}>
                <Box style={{
                    flex: 1,
                    background: '#EFF6FF',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #DBEAFE',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 13, color: '#1E40AF', fontWeight: 600 }}>
                        Benchmark 驱动
                    </Text>
                    <Text style={{ fontSize: 11, color: '#64748B', marginTop: 2 }}>
                        用科学评测定义研究问题
                    </Text>
                </Box>
                <Box style={{
                    flex: 1,
                    background: '#EFF6FF',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #DBEAFE',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 13, color: '#1E40AF', fontWeight: 600 }}>
                        学术 + 工业双轨
                    </Text>
                    <Text style={{ fontSize: 11, color: '#64748B', marginTop: 2 }}>
                        顶会论文 + 业务落地
                    </Text>
                </Box>
                <Box style={{
                    flex: 1,
                    background: '#EFF6FF',
                    borderRadius: 10,
                    padding: '12px 16px',
                    border: '1px solid #DBEAFE',
                    alignItems: 'center',
                }}>
                    <Text style={{ fontSize: 13, color: '#1E40AF', fontWeight: 600 }}>
                        开源与影响力
                    </Text>
                    <Text style={{ fontSize: 11, color: '#64748B', marginTop: 2 }}>
                        632 一作 stars · 机器之心 / 量子位报道
                    </Text>
