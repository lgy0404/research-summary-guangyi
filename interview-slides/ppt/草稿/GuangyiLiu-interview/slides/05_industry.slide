<Slide>
    <Box style={{
        width: '100%',
        height: '100%',
        background: '#FFFFFF',
        padding: '0 70px',
        position: 'relative',
    }}>
        {/* A 区：标题块 */}
        <Box style={{
            height: 120,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
            borderBottom: '2px solid #E2E8F0',
        }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{
                    width: 6,
                    height: 32,
                    background: '#F97316',
                }} />
                <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0F172A' }}>
                    实习经历
                </Text>
                <Text style={{ fontSize: 16, color: '#64748B', letterSpacing: 3, marginTop: 8 }}>
                    INDUSTRY EXPERIENCE
                </Text>
            </Box>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                2024.08 - 2026.07 · 两段研究实习
            </Text>
        </Box>

        {/* B 区：两栏对比 */}
        <Box style={{
            height: 540,
            flexDirection: 'row',
            gap: 28,
            paddingTop: 32,
            paddingBottom: 24,
        }}>
            {/* 左：快手（最新） */}
            <Box style={{
                flex: 1,
                background: 'linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%)',
                borderRadius: 16,
                padding: '28px 30px',
                flexDirection: 'column',
                boxShadow: '0 12px 32px rgba(30,64,175,0.3)',
            }}>
                {/* Logo + 时间 */}
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 18 }}>
                    <Box style={{
                        background: '#FFFFFF',
                        borderRadius: 12,
                        padding: 12,
                        width: 76,
                        height: 76,
                        alignItems: 'center',
                        justifyContent: 'center',
                    }}>
                        <Image src="assets/kuaishou-icon.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                    </Box>
                    <Box style={{
                        background: 'rgba(255,255,255,0.2)',
                        borderRadius: 6,
                        padding: '6px 12px',
                        border: '1px solid rgba(255,255,255,0.3)',
                    }}>
                        <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 600 }}>
                            2025.08 - 2026.07
                        </Text>
                    </Box>
                </Box>

                <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', marginBottom: 4 }}>
                    快手科技
                </Text>
                <Text style={{ fontSize: 15, color: '#BFDBFE', marginBottom: 16 }}>
                    Kuaishou Technology · 研究实习生
                </Text>

                <Box style={{
                    background: 'rgba(255,255,255,0.12)',
                    borderRadius: 10,
                    padding: '14px 16px',
                    marginBottom: 14,
                    border: '1px solid rgba(255,255,255,0.2)',
                }}>
                    <Text style={{ fontSize: 13, color: '#DBEAFE', marginBottom: 4, fontWeight: 600 }}>
                        项目方向
                    </Text>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', lineHeight: 1.6 }}>
                        面向 <span style={{ fontWeight: 'bold' }}>App 缺陷检测</span> 的内部 GUI 智能体系统
                    </Text>
                </Box>

                <Box style={{ flexDirection: 'column', gap: 8 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 6, height: 6, borderRadius: '50%', background: '#F97316', flexShrink: 0 }} />
                        <Text style={{ fontSize: 13, color: '#DBEAFE', lineHeight: 1.6 }}>
                            Mentor：Martin Li
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 10 }}>
                        <Box style={{ width: 6, height: 6, borderRadius: '50%', background: '#F97316', flexShrink: 0, marginTop: 7 }} />
                        <Text style={{ fontSize: 13, color: '#DBEAFE', lineHeight: 1.6 }}>
                            将学术成果（MobileForge / MemGUI-Agent）落地到真实业务场景
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    marginTop: 'auto',
                    paddingTop: 14,
                    borderTop: '1px solid rgba(255,255,255,0.2)',
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 8,
                }}>
                    <Text style={{ fontSize: 12, color: '#BFDBFE' }}>
                        关键词
                    </Text>
                    <Box style={{ background: '#F97316', borderRadius: 4, padding: '3px 8px' }}>
                        <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 600 }}>工程落地</Text>
                    </Box>
                </Box>
            </Box>

            {/* 右：vivo */}
            <Box style={{
                flex: 1,
                background: '#F8FAFC',
                borderRadius: 16,
                padding: '28px 30px',
                flexDirection: 'column',
                border: '1px solid #E2E8F0',
            }}>
                <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 18 }}>
                    <Box style={{
                        background: '#FFFFFF',
                        borderRadius: 12,
                        padding: 12,
                        width: 76,
                        height: 76,
                        alignItems: 'center',
                        justifyContent: 'center',
                        border: '1px solid #E2E8F0',
                    }}>
                        <Image src="assets/vivo-logo.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
                    </Box>
                    <Box style={{
                        background: '#EFF6FF',
                        borderRadius: 6,
                        padding: '6px 12px',
                        border: '1px solid #DBEAFE',
                    }}>
                        <Text style={{ fontSize: 13, color: '#1E40AF', fontWeight: 600 }}>
                            2024.08 - 2025.08
                        </Text>
                    </Box>
                </Box>

                <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#0F172A', marginBottom: 4 }}>
                    vivo AI Lab
                </Text>
                <Text style={{ fontSize: 15, color: '#64748B', marginBottom: 16 }}>
                    vivo AI 研究院 · 研究实习生
                </Text>

                <Box style={{
                    background: '#FFFFFF',
                    borderRadius: 10,
                    padding: '14px 16px',
                    marginBottom: 14,
                    border: '1px solid #E2E8F0',
                }}>
                    <Text style={{ fontSize: 13, color: '#64748B', marginBottom: 4, fontWeight: 600 }}>
                        项目方向
                    </Text>
                    <Text style={{ fontSize: 14, color: '#0F172A', lineHeight: 1.6 }}>
                        参与 <span style={{ fontWeight: 'bold', color: '#1E40AF' }}>vivo PhoneGPT</span>：通用手机 GUI 智能体
                    </Text>
                </Box>

                <Box style={{ flexDirection: 'column', gap: 8 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 6, height: 6, borderRadius: '50%', background: '#3B82F6', flexShrink: 0 }} />
                        <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.6 }}>
                            Mentor：刘亮 博士 · 李宏升 教授（CUHK）
                        </Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 10 }}>
                        <Box style={{ width: 6, height: 6, borderRadius: '50%', background: '#3B82F6', flexShrink: 0, marginTop: 7 }} />
                        <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.6 }}>
                            从零接触 GUI Agent 方向，产出 LearnAct / Phone GUI Survey 等奠基性成果
                        </Text>
                    </Box>
                </Box>

                <Box style={{
                    marginTop: 'auto',
                    paddingTop: 14,
                    borderTop: '1px solid #E2E8F0',
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 8,
                }}>
                    <Text style={{ fontSize: 12, color: '#94A3B8' }}>
                        关键词
                    </Text>
                    <Box style={{ background: '#EFF6FF', borderRadius: 4, padding: '3px 8px', border: '1px solid #DBEAFE' }}>
                        <Text style={{ fontSize: 11, color: '#1E40AF', fontWeight: 600 }}>学术起步</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* C 区：页脚 */}
        <Box style={{
            height: 60,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
            borderTop: '1px solid #E2E8F0',
        }}>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                Guangyi Liu · ZJU · 面试陈述
            </Text>
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>
                05 / 15
            </Text>
        </Box>
    </Box>
</Slide>
